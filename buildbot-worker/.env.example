# Copy to .env and fill in. Required: must match a worker.Worker(name, ...)
# entry (and its BUILDBOT_WORKER_<NAME>_PASSWORD) in the master's master.cfg.
BUILDBOT_MASTER_HOST=buildbot.example.org
BUILDBOT_WORKER_NAME=worker01
BUILDBOT_WORKER_PASSWORD=changeme

# Optional, see docker-compose.yml for defaults.
#BUILDBOT_MASTER_PORT=9989
#BUILDBOT_JOBS=4
#BUILDBOT_TMPFS_GIGS=4
#BUILDBOT_CCACHE_MAXSIZE_GIGS=5
#BUILDBOT_UID=1000
#BUILDBOT_GID=1000
