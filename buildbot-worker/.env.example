# Copy to .env and fill in. Name and password must match a name:password
# entry in the dispatcher's BUILDBOT_WORKERS.
BUILDBOT_DISPATCHER_HOST=buildbot.example.org
BUILDBOT_WORKER_NAME=worker01
BUILDBOT_WORKER_PASSWORD=changeme

# Number of workers (parallel builds) on this machine, up to the dispatcher's
# limit for this entry (16 by default).
#BUILDBOT_WORKER_COUNT=1

# Optional, see docker-compose.yml for defaults and README.md for sizing.
#BUILDBOT_DISPATCHER_PORT=9989
#BUILDBOT_JOBS=4
#BUILDBOT_WORKDIR_GIGS=8
#BUILDBOT_CCACHE_GIGS=8
#BUILDBOT_TMPFS_GIGS=4
#BUILDBOT_UID=1000
#BUILDBOT_GID=1000
#WATCHTOWER_POLL_INTERVAL=3600
